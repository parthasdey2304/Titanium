# Titanium AI Assistant Configuration
# Rename this file to .env and place it in the same folder as Titanium.exe

# Required: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: ElevenLabs Voice Synthesis (falls back to native Windows TTS if empty)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_NAME=Charlie
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Assistant Customization
ASSISTANT_NAME=Titanium
LANGUAGE_MODE=hinglish
